function avColor(id){ const n=parseInt(id.replace('PLR_',''));return AV_COLORS[n%AV_COLORS.length]; }

// ── Render artilheiros ───────────────────────────────────────────────────
function renderArtilheiros(){
  const max = ARTILHEIROS[0].goals;
  const rankColors = ['gold','silver','bronze'];
  const barColors  = ['#C9933A','#8A8A8A','#8B5E3C'];
  const html = ARTILHEIROS.map((p,i)=>{
    const rank = i+1;
    const pct  = (p.goals/max*100).toFixed(1);
    const rankCls = rankColors[i]||'';
    const barCol  = barColors[i]||'#C85A1A';
    const isGold  = i===0;
    const saiu    = p.status==='saiu';
    return `<div class="art-row${isGold?' gold-row':''}">
      <div class="art-rank ${rankCls}">${rank}</div>
      <div class="art-av" style="background:${avColor(p.id)}">${p.ini}</div>
      <div class="art-info">
        <div class="art-name">${p.name}${saiu?'<span class="art-saiu">saiu</span>':''}</div>
        <div class="art-pos">${p.pos}${p.jersey?' · '+p.jersey:''}</div>
        <div class="art-bar-bg" style="margin-top:6px">
          <div class="art-bar-fill" style="width:${pct}%;background:${barCol}"></div>
        </div>
      </div>
      <div class="art-goals${rank>2?' small':''}">${p.goals}</div>
    </div>`;
  }).join('');
  document.getElementById('art-list-container').innerHTML = html;
}

// ── Render jogos ─────────────────────────────────────────────────────────
function renderJogos(){
  // reverse for latest first
  const html = [...JOGOS].reverse().map(j=>{
    const score = (j.gf!==null && j.gf!==undefined) ? `${j.gf}×${j.ga}` : '—×—';
    const rCls  = ['V','D','E'].includes(j.result)?j.result:'nd';
    const rLabel= j.result==='?'?'—':j.result;
    return `<div class="jogo-item">
      <div class="jogo-serial">${j.serial}</div>
      <div class="jogo-info">
        <div class="jogo-opp">${j.opp}</div>
        <div class="jogo-date">${j.date}</div>
      </div>
      <div class="jogo-score">${score}</div>
      <div class="jogo-result ${rCls}">${rLabel}</div>
    </div>`;
  }).join('');
  document.getElementById('jogos-list').innerHTML = html;
}

// ── Render elenco ────────────────────────────────────────────────────────
function renderElenco(){
  const order = ['titular','peneira','fora_temp','saiu'];
  const sorted = [...PLAYERS].sort((a,b)=>order.indexOf(a.status)-order.indexOf(b.status)||b.goals-a.goals);
  const posLabel = {GL:'Goleiro',ZG:'Zagueiro',ZC:'Zag.Central',LD:'Lat.Dir',LE:'Lat.Esq',MC:'Meia',MA:'Meia-Atac',AT:'Atacante'};
  const html = sorted.map(p=>{
    const isSaiu = p.status==='saiu';
    const isPeneira = p.status==='peneira';
    const isCap = p.id==='PLR_001';
    const goalsStr = p.goals>0?`<div class="pc-goals">⚽ <span>${p.goals}</span> gols</div>`:'';
    let badge = '';
    if(isPeneira) badge='<div class="pc-badge" title="Em avaliação">🔍</div>';
    if(p.status==='fora_temp') badge='<div class="pc-badge" title="Fora temporariamente">🤕</div>';
    return `<div class="player-card${isSaiu?' saiu':''}" onclick="openModal('${p.id}')">
      <div class="pc-av" style="background:${avColor(p.id)};position:relative">
        ${p.ini}
        ${isCap?'<div class="pc-cap">©</div>':''}
        ${badge}
      </div>
      <div class="pc-name">${p.name}</div>
      <div class="pc-nick">${p.nick}</div>
      <div class="pc-pos">${posLabel[p.pos]||p.pos}</div>
      ${goalsStr}
    </div>`;
  }).join('');
  document.getElementById('elenco-grid').innerHTML = html;
}

// ── Modal ─────────────────────────────────────────────────────────────────
function openModal(id){
  const p = PLAYERS.find(x=>x.id===id);
  if(!p) return;
  const posLabel = {GL:'Goleiro',ZG:'Zagueiro',ZC:'Zag.Central',LD:'Lat.Dir',LE:'Lat.Esq',MC:'Meia',MA:'Meia-Atac',AT:'Atacante'};
  document.getElementById('m-av').textContent = p.ini;
  document.getElementById('m-av').style.background = avColor(p.id);
  document.getElementById('m-name').textContent = p.name;
  document.getElementById('m-nick').textContent = p.nick + (p.jersey?' · '+p.jersey:'');
  document.getElementById('m-pos').textContent = posLabel[p.pos]||p.pos;
  document.getElementById('m-goals').textContent = p.goals||'—';
  document.getElementById('m-group').textContent = p.group==='EstAzul'?'Est.Azul':'Free Agent';
  document.getElementById('m-jersey').textContent = p.jersey||'—';
  document.getElementById('m-notes').textContent = p.note||(p.status==='saiu'?'Saiu do clube':'');
  document.getElementById('player-modal').classList.add('open');
}
function closeModal(e){
  if(!e||e.target===document.getElementById('player-modal'))
    document.getElementById('player-modal').classList.remove('open');
}

// ── Nav ───────────────────────────────────────────────────────────────────
function showScreen(id, btn){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(b=>b.classList.remove('active'));
  document.getElementById('screen-'+id).classList.add('active');
  btn.classList.add('active');
}

